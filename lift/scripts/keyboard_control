#!/usr/bin/env zsh
# 从源码树启动（zsh）：自动 source ROS 与工作空间 install，再运行 lift 键盘控制台。
# *.bash 在子 bash 里 source，避免 zsh 下 BASH_SOURCE 未定义、COLCON_TRACE 与 set -u 等问题。
# 指定串口示例:
#   LIFT_SERIAL_PORT=/dev/ttyACM1 ./scripts/keyboard_control
#   ./scripts/keyboard_control -- --port /dev/ttyACM1
emulate -R zsh
setopt errreturn pipefail
unsetopt nounset 2>/dev/null

_script_path=${0:A}
_DIR=${_script_path:h}
_PKG=$(cd "$_DIR/.." && pwd)
_SRC=$(cd "$_PKG/.." && pwd)
_WS=$(cd "$_SRC/.." && pwd)

if [[ ! -f "$_WS/install/setup.bash" ]]; then
  echo "[ERROR] 未找到 $_WS/install/setup.bash — 请先在 $_WS 执行: colcon build --packages-select lift" >&2
  exit 1
fi

ros_setup=""
if [[ -z "${ROS_DISTRO:-}" ]]; then
  for _d in humble jazzy iron; do
    if [[ -f "/opt/ros/${_d}/setup.bash" ]]; then
      ros_setup="/opt/ros/${_d}/setup.bash"
      break
    fi
  done
fi

export WS="$_WS"
export ROS_SETUP="$ros_setup"
exec bash -c '
set -eo pipefail
if [[ -n "${ROS_SETUP:-}" ]]; then
  # shellcheck source=/dev/null
  source "$ROS_SETUP"
fi
# shellcheck source=/dev/null
source "$WS/install/setup.bash"
exec ros2 run lift keyboard_control "$@"
' keyboard_control "$@"
